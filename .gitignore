# =========================================================
# ENTORNOS Y DEPENDENCIAS LOCALES
# =========================================================
.venv/
venv/
env/

# =========================================================
# PYTHON
# =========================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Build / empaquetado
build/
dist/
.eggs/
*.egg-info/

# Cachés y herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/

# =========================================================
# VARIABLES DE ENTORNO / SECRETOS
# =========================================================
.env
.env.*
!.env.example

# =========================================================
# EDITORES / SISTEMA
# =========================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# =========================================================
# LOGS Y TEMPORALES
# =========================================================
*.log
*.tmp
*.temp
*.bak

# =========================================================
# INPUT PESADO NO VERSIONABLE
# Mantén estructura, pero no subas videos reales
# =========================================================
input/videos/*
input/test_videos/*
input/samples/*

# Conservar estructura vacía si usas .gitkeep
!input/videos/.gitkeep
!input/test_videos/.gitkeep
!input/samples/.gitkeep

# =========================================================
# OUTPUT LEGACY
# Si todavía usas output/, ignóralo completo
# =========================================================
output/**

# Conservar estructura vacía si usas .gitkeep
!output/.gitkeep
!output/frames/.gitkeep
!output/events_raw/.gitkeep
!output/steps_normalized/.gitkeep
!output/reports/.gitkeep
!output/guides_docx/.gitkeep
!output/logs/.gitkeep

# =========================================================
# RUNS GENERADOS
# Conservar solo el template de referencia
# =========================================================
runs/run_*/
runs/run_*/**
!runs/_template_run/
!runs/_template_run/**

# =========================================================
# FRAMES E IMÁGENES GENERADAS
# =========================================================
*.jpg
*.jpeg
*.png
*.webp

# =========================================================
# DOCUMENTOS EXPORTADOS GENERADOS
# Ignora salidas finales, pero conserva documentación fuente
# =========================================================
*.docx
*.pdf

!README.pdf

# Si en el futuro generas guías markdown y no quieres versionarlas,
# puedes ignorar una carpeta concreta en vez de todos los .md:
# guides/**/*.md

# =========================================================
# DATOS VOLÁTILES
# =========================================================
data/cache/**
data/session_state.json

# Conservar índices base si forman parte del proyecto
!data/video_index.json

# =========================================================
# MODELOS / PESADOS
# =========================================================
*.ckpt
*.pt
*.pth
*.onnx
*.bin
*.safetensors

# =========================================================
# AUDIO / EXTRACCIONES TEMPORALES
# =========================================================
*.wav
*.mp3

# =========================================================
# ARCHIVOS DE OFFICE TEMPORALES
# =========================================================
~$*.docx
~$*.xlsx
~$*.pptx
