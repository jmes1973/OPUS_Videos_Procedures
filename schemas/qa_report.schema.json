{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qa_report",
  "type": "object",
  "properties": {
    "video_id": { "type": "string" },
    "status": { "type": "string" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": { "type": "string" },
          "severity": { "type": "string" },
          "message": { "type": "string" },
          "related_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["issue_id", "severity", "message"]
      }
    }
  },
  "required": ["video_id", "status", "issues"]
}
