{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "timeline_raw",
  "type": "object",
  "properties": {
    "video_id": { "type": "string" },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence_id": { "type": "string" },
          "event_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "summary": { "type": "string" },
          "start_time": { "type": "string" },
          "end_time": { "type": "string" }
        },
        "required": ["sequence_id", "event_ids", "summary"]
      }
    }
  },
  "required": ["video_id", "timeline"]
}
